//
// named.conf
//
// Provided by Red Hat bind package to configure the ISC BIND named(8) DNS
// server as a caching only nameserver (as a localhost DNS resolver only).
//
// See /usr/share/doc/bind*/sample/ for example named configuration files.
//

options {
	listen-on port 53 { any; };
	listen-on-v6 port 53 { any; };
	forwarders { {{ puppeteers_dns_forwarder_forwarders }} };
	forward only;
	directory 	"{{ puppeteers_dns_forwarder_var_path }}";
	dump-file 	"{{ puppeteers_dns_forwarder_data_path }}/cache_dump.db";
	statistics-file "{{ puppeteers_dns_forwarder_data_path }}/named_stats.txt";
	memstatistics-file "{{ puppeteers_dns_forwarder_data_path }}/named_mem_stats.txt";
	secroots-file	"{{ puppeteers_dns_forwarder_data_path }}/named.secroots";
	recursing-file	"{{ puppeteers_dns_forwarder_data_path }}/named.recursing";
	allow-query { {{ puppeteers_dns_forwarder_allow_query }} };

	# Disable DNSSec validation for these domains
	validate-except {
		{% for unvalidated_domain in puppeteers_dns_forwarder_unvalidated_domains %}
		"{{ unvalidated_domain }}";
		{% endfor %}
	};

	/* 
	 - If you are building an AUTHORITATIVE DNS server, do NOT enable recursion.
	 - If you are building a RECURSIVE (caching) DNS server, you need to enable 
	   recursion. 
	 - If your recursive DNS server has a public IP address, you MUST enable access 
	   control to limit queries to your legitimate users. Failing to do so will
	   cause your server to become part of large scale DNS amplification 
	   attacks. Implementing BCP38 within your network would greatly
	   reduce such attack surface 
	*/
	recursion yes;
	allow-recursion { {{ puppeteers_dns_forwarder_allow_query }} };

	dnssec-validation yes;

	managed-keys-directory "{{ puppeteers_dns_forwarder_var_path }}/dynamic";
	geoip-directory "/usr/share/GeoIP";

	pid-file "/run/named/named.pid";
	session-keyfile "/run/named/session.key";

	/* https://fedoraproject.org/wiki/Changes/CryptoPolicy */
	include "/etc/crypto-policies/back-ends/bind.config";

	/* Stale cache settings */
	stale-cache-enable {{ puppeteers_dns_forwarder_stale_cache_enable }};
	stale-answer-enable {{ puppeteers_dns_forwarder_stale_answers_enable }};
	stale-refresh-time {{ puppeteers_dns_forwarder_stale_refresh_time }};
	stale-answer-ttl {{ puppeteers_dns_forwarder_stale_answer_ttl }};
};

logging {
        channel default_debug {
                file "data/named.run";
                severity dynamic;
        };
};

zone "." IN {
	type hint;
	file "named.ca";
};

include "{{ puppeteers_dns_forwarder_rfc1918_zone_file }}";
include "{{ puppeteers_dns_forwarder_root_key }}";

